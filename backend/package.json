{
  "name": "smart-clinic-backend",
  "version": "1.0.0",
  "description": "Backend API for Smart Clinic Scheduling System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --runInBand --forceExit tests/unit",
    "test:integration": "jest --runInBand --forceExit tests/integration",
    "test:properties": "jest --runInBand --forceExit tests/properties",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node ../scripts/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "fast-check": "^3.22.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0"
  }
}
