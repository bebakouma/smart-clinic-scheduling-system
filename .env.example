DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_clinic
PORT=3000

# Authentication
JWT_SECRET=change-me-in-production

# Security hardening (Task 18)
# Comma-separated list of allowed frontend origins. If unset, all origins are
# allowed (development only).
ALLOWED_ORIGINS=http://localhost:5173
# API rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Stricter limit for /api/auth endpoints (brute-force protection)
AUTH_RATE_LIMIT_MAX=20
# Notifications (Task 20)
# Provider mode: "console" (default) logs instead of sending — no account
# needed, safe for dev/test. Set to "sendgrid+twilio" to enable real delivery.
NOTIFICATION_PROVIDER=console
# SendGrid (email) — only needed when NOTIFICATION_PROVIDER enables real sending
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Twilio (SMS) — only needed to enable SMS delivery
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Scheduled reminder job (Task 21)
# Enable/disable the automatic reminder job. Default: true.
REMINDER_JOB_ENABLED=true
# Cron expression for how often the job runs. Default: every 15 minutes.
REMINDER_CRON=*/15 * * * *
# Patient check-in kiosk (Task 23)
# Max kiosk check-in attempts per 15 minutes per IP. One kiosk serves many
# patients from one IP, so this is higher than the auth limit.
KIOSK_RATE_LIMIT_MAX=60
# IoT device token (Task 24) - TEMPORARY shared placeholder, replaced in Task 26
# by a unique token for each device. If this is empty, every device request is
# rejected. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit a real value.
DEVICE_TOKEN=
