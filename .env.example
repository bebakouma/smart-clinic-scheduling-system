DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_clinic
PORT=3000

# Authentication
JWT_SECRET=change-me-in-production

# Security hardening (Task 18)
# Comma-separated list of allowed frontend origins. If unset, all origins are
# allowed (development only).
ALLOWED_ORIGINS=http://localhost:5173
# API rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Stricter limit for /api/auth endpoints (brute-force protection)
AUTH_RATE_LIMIT_MAX=20
